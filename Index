  background-size: 40px 40px;
  pointer-events: none;
  z-index: 0;
}

/* ───── SCANLINE OVERLAY ───── */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2px,
    rgba(0,0,0,0.07) 2px,
